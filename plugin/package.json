{
  "name": "dsh-plugin-compat-check",
  "version": "0.2.2",
  "description": "Checks installed DSH plugin compatibility and static upgrade risks, including exact DSH 0.2.1-rc.5 support. Multilingual UI, source evidence, manual reviews and report history.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "README.md",
    "skill/",
    "lib/",
    "cordis.patch.yml",
    "kernel/",
    "scripts/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "prepack": "node scripts/stage-skill.mjs && node scripts/stage-contract.mjs && node scripts/stage-kernel.mjs",
    "postpack": "node scripts/unstage-kernel.mjs",
    "prepublishOnly": "node scripts/prepublish-check.mjs",
    "stage-skill": "node scripts/stage-skill.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "compatibility",
    "health-check",
    "cordis",
    "agent-skills",
    "static-analysis",
    "dependency-analysis",
    "upgrade",
    "i18n",
    "manual-review",
    "report-history"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcy0121/dsh-plugin-compat-check.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/lcy0121/dsh-plugin-compat-check#readme",
  "bugs": {
    "url": "https://github.com/lcy0121/dsh-plugin-compat-check/issues"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "semver": "7.7.3",
    "yaml": "2.9.1"
  }
}
