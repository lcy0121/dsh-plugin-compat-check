{
  "name": "dsh-plugin-compat-check",
  "version": "0.1.1",
  "description": "Reports which installed DSH plugins are compatible with the current DSH version, with file:line and reason. The judgement kernel is staged into kernel/ at pack time, so the published tarball is self-contained.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "README.md",
    "skill/",
    "lib/",
    "cordis.patch.yml",
    "kernel/",
    "scripts/",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "prepack": "node scripts/stage-skill.mjs && node scripts/stage-kernel.mjs",
    "postpack": "node scripts/unstage-kernel.mjs",
    "prepublishOnly": "node scripts/prepublish-check.mjs",
    "stage-skill": "node scripts/stage-skill.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "compatibility",
    "health-check",
    "cordis",
    "agent-skills",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcy0121/dsh-plugin-compat-check.git"
  },
  "homepage": "https://github.com/lcy0121/dsh-plugin-compat-check#readme",
  "bugs": {
    "url": "https://github.com/lcy0121/dsh-plugin-compat-check/issues"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "semver": "7.7.3"
  }
}
